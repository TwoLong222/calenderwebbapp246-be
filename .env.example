# =========================================================
# .env.example — Backend (NestJS)
# Copy file này thành .env và điền giá trị thật.
# Lấy các giá trị tại: Supabase Dashboard > Project Settings > API
# =========================================================

# URL của Supabase project (dạng https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — dùng cho các thao tác tuân theo RLS (client-side an toàn)
SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key — CÓ QUYỀN BYPASS RLS HOÀN TOÀN.
# CHỈ dùng ở backend (NestJS), TUYỆT ĐỐI không expose ra frontend/client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cổng chạy NestJS server
PORT=3000

# Môi trường: development | production
NODE_ENV=development

# URL gốc của API dùng trong LINK Đồng ý/Từ chối gửi qua email.
# Local để mặc định; khi deploy thật đổi thành domain công khai (vd https://api.tencuaban.com/api)
# để link trong email bấm được từ máy khác. Không điền -> mặc định http://localhost:3000/api
PUBLIC_API_URL=http://localhost:3000/api

# =========================================================
# SMTP — cấu hình gửi email (MailService dùng các biến này)
# =========================================================
# --- CÁCH 1: TEST với Mailtrap (email KHÔNG gửi thật, chỉ xem trong hộp thư giả lập) ---
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_SECURE=false
#   SMTP_USER=<mailtrap-user>
#   SMTP_PASS=<mailtrap-pass>
#
# --- CÁCH 2: GỬI THẬT qua Gmail (cần bật 2FA rồi tạo App Password 16 ký tự
#     tại https://myaccount.google.com/apppasswords — KHÔNG dùng mật khẩu Gmail thường) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Địa chỉ hiển thị ở ô "From" — nên trùng SMTP_USER để Gmail không chặn/đánh spam
SMTP_FROM=your-gmail@gmail.com

# Gemini API key cho Trợ lý AI (lấy tại https://aistudio.google.com/apikey).
# NHIỀU key thì ngăn bằng dấu phẩy — hết hạn mức key đầu thì tự dùng key sau:
#   GEMINI_API_KEY=key_project_A,key_project_B
# CHỈ có tác dụng khi các key thuộc PROJECT KHÁC NHAU. Nhiều key trong CÙNG một project
# vẫn dùng chung hạn mức nên khai báo bao nhiêu cũng vô ích.
# Tổng lượt/ngày = số project × số model (xem GEMINI_MODEL bên dưới).
GEMINI_API_KEY=your-gemini-api-key

# Model Gemini dùng cho Trợ lý AI. Gói MIỄN PHÍ giới hạn 20 lượt/ngày cho MỖI MODEL trong
# MỖI PROJECT — nên khai báo NHIỀU model ngăn bằng dấu phẩy: hết lượt model đầu thì code
# tự nhảy sang model kế tiếp, tổng lượt/ngày nhân lên theo số model.
# Kết hợp với nhiều KEY khác project (xem GEMINI_API_KEY ở trên) thì nhân tiếp.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-3.1-flash-lite
