# =========================================================
# .env.example — Backend (NestJS)
# Copy file này thành .env và điền giá trị thật.
# Lấy các giá trị tại: Supabase Dashboard > Project Settings > API
# =========================================================

# URL của Supabase project (dạng https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — dùng cho các thao tác tuân theo RLS (client-side an toàn)
SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key — CÓ QUYỀN BYPASS RLS HOÀN TOÀN.
# CHỈ dùng ở backend (NestJS), TUYỆT ĐỐI không expose ra frontend/client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cổng chạy NestJS server
PORT=3000

# Môi trường: development | production
NODE_ENV=development

# URL gốc của API dùng trong LINK Đồng ý/Từ chối gửi qua email.
# Local để mặc định; khi deploy thật đổi thành domain công khai (vd https://api.tencuaban.com/api)
# để link trong email bấm được từ máy khác. Không điền -> mặc định http://localhost:3000/api
PUBLIC_API_URL=http://localhost:3000/api

# =========================================================
# SMTP — cấu hình gửi email (MailService dùng các biến này)
# =========================================================
# --- CÁCH 1: TEST với Mailtrap (email KHÔNG gửi thật, chỉ xem trong hộp thư giả lập) ---
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_SECURE=false
#   SMTP_USER=<mailtrap-user>
#   SMTP_PASS=<mailtrap-pass>
#
# --- CÁCH 2: GỬI THẬT qua Gmail (cần bật 2FA rồi tạo App Password 16 ký tự
#     tại https://myaccount.google.com/apppasswords — KHÔNG dùng mật khẩu Gmail thường) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Địa chỉ hiển thị ở ô "From" — nên trùng SMTP_USER để Gmail không chặn/đánh spam
SMTP_FROM=your-gmail@gmail.com
